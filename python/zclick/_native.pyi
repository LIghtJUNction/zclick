from collections.abc import Sequence
from typing import Any, Callable, TypedDict

class ParseError(TypedDict):
    kind: str
    option: str
    id: int | None
    nargs: int
    message: str

Spec = tuple[int, Sequence[str], int, bool] | tuple[int, Sequence[str], int, bool, bool]

class ParserPlan:
    def __init__(self, specs: Sequence[Spec]) -> None: ...
    @staticmethod
    def from_definitions(definitions: Sequence[Any], option_type: type, previous: ParserPlan | None = None) -> ParserPlan: ...
    def matches_definitions(self, definitions: Sequence[Any], option_type: type) -> bool: ...
    def parse(self, argv: Sequence[str], allow_interspersed_args: bool = True,
              ignore_unknown_options: bool = False, normalizer: Callable[[str], str] | None = None,
              original_args: list[str] | None = None) -> tuple[dict[int, list[tuple[str, ...]]], list[str], list[int], ParseError | None]: ...
    def parse_into(self, argv: Sequence[str], definitions: Sequence[Any], state: Any, unset: Any,
                   flag_needs_value: Any, allow_interspersed_args: bool = True,
                   ignore_unknown_options: bool = False, normalizer: Callable[[str], str] | None = None,
                   original_args: list[str] | None = None) -> tuple[list[str], ParseError | None]: ...

def parse(specs: Sequence[Spec], argv: Sequence[str], allow_interspersed_args: bool = True,
          ignore_unknown_options: bool = False, normalizer: Callable[[str], str] | None = None, original_args: list[str] | None = None) -> tuple[dict[int, list[tuple[str, ...]]], list[str], list[int], ParseError | None]: ...
def processing_order(eager: Sequence[bool], encounter_indices: Sequence[int]) -> list[int]: ...
def order_parameters(invocation_order: Sequence[Any], declaration_order: Sequence[Any]) -> list[Any]: ...
def strip_ansi(text: str) -> str: ...
def text_width(text: str) -> int: ...
def truncate_visible(text: str, n: int) -> str: ...
def wrap_text(text: str, width: int = 78, initial_indent: str | None = None,
              subsequent_indent: str | None = None, preserve_paragraphs: bool = False) -> str: ...
def join_options(options: Sequence[str]) -> tuple[str, bool]: ...
ZCLAP_VERSION: str

def select_parameter_value(existing_missing: bool, existing_source: int | None, incoming_source: int, existing_explicit: bool, incoming_explicit: bool) -> bool: ...

def invoke_group(group: Any, ctx: Any, base_invoke: Callable[..., Any], scope: Callable[..., tuple[bool, Any]]) -> Any: ...

def parse_into(specs: Sequence[Spec], argv: Sequence[str], definitions: Sequence[Any], state: Any, unset: Any, flag_needs_value: Any, allow_interspersed_args: bool = True, ignore_unknown_options: bool = False, normalizer: Callable[[str], str] | None = None, original_args: list[str] | None = None) -> tuple[list[str], ParseError | None]: ...
